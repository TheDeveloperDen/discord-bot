{
	"name": "devdenbot",
	"version": "11.0.0",
	"type": "module",
	"main": "src/index.ts",
	"engines": {
		"node": "24"
	},
	"packageManager": "bun@1.4.2",
	"scripts": {
		"version": "echo $npm_package_version",
		"lint": "bunx biome check --fix",
		"typecheck": "bunx tsc  --build --noEmit tsconfig.json",
		"typecheck:prod": "bunx tsc --noEmit -p tsconfig.production.json",
		"watch-dev": "bun --watch src/index.ts",
		"start": "bun --trace-warnings src/index.ts",
		"start:prod": "NODE_ENV=production bun run start",
		"prepare": "bunx husky || true",
		"test": "bun test",
		"test:retry": "scripts/bun-test-retry.sh"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
			"biome check --write --no-errors-on-unmatched"
		]
	},
	"keywords": [],
	"author": "Developer Den",
	"license": "MIT",
	"dependencies": {
		"@napi-rs/canvas": "^1.0.11",
		"@sentry/bun": "^11.7.0",
		"@sequelize/core": "^7.0.0-alpha.48",
		"@sequelize/postgres": "^7.0.0-alpha.48",
		"@sequelize/sqlite3": "^7.0.0-alpha.48",
		"bufferutil": "^4.1.0",
		"discord.js": "^14.27.0",
		"disjsx": "github:TheDeveloperDen/disjsx",
		"expiry-map": "^2.0.0",
		"handlebars": "^4.7.10",
		"hot-takes": "git+https://github.com/bristermitten/hot-takes.git#fe74913b7a3d08df5b852eaf2995f6b7ac5e7f2c",
		"node-schedule": "^2.1.1",
		"pg": "^8.23.1",
		"react": "^19.3.0",
		"safe-stable-stringify": "^2.5.0",
		"sharp": "^0.35.5",
		"string-comparison": "^1.3.0",
		"tslib": "^2.8.1",
		"winston": "^3.19.0",
		"yaml": "^2.9.1"
	},
	"trustedDependencies": [
		"bufferutil",
		"sqlite3",
		"utf-8-validate"
	],
	"repository": "https://github.com/TheDeveloperDen/DevDenBot.git",
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@sinonjs/fake-timers": "^15.4.0",
		"@types/bun": "^1.4.3",
		"@types/node": "^26.6.5",
		"@types/node-schedule": "^2.1.8",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.3.0",
		"@types/sinonjs__fake-timers": "^15.0.1",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"typescript": "^7.0.2"
	}
}
